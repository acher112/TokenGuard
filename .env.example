# =============================================================================
# AgentWatch — Environment Variables Template
# =============================================================================
# Copy this file to apps/web/.env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------
# Your Supabase project's connection string (Transaction mode pooler recommended)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=""

# For Drizzle migrations (direct connection, not pooled)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL_UNPOOLED=""

# -----------------------------------------------------------------------------
# AUTH (Auth.js / NextAuth v5)
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
AUTH_SECRET=""

# The public URL of your app (no trailing slash)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# EMAIL (Resend)
# https://resend.com — free tier: 3,000 emails/month
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# BILLING (Paddle Billing v2 — Merchant of Record & Payoneer Payouts)
# Leave blank during local development; billing features will use stub provider.
# -----------------------------------------------------------------------------
# Paddle API key from Developer Tools -> Authentication
PADDLE_API_KEY=""

# Paddle Webhook Secret from Developer Tools -> Notifications
PADDLE_WEBHOOK_SECRET=""

# Paddle price IDs from Catalog -> Products -> Prices (e.g. "pri_01h...")
PADDLE_PRO_PRICE_ID=""
PADDLE_TEAM_PRICE_ID=""

# Environment: "sandbox" for testing or "production"
PADDLE_ENVIRONMENT="sandbox"

# Legacy Lemon Squeezy (optional fallback)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_TEAM_VARIANT_ID=""


# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
# Environment: "development" | "production"
NODE_ENV="development"

# Public app URL (used in emails, SDK docs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ingest API rate limit (requests per minute per API key)
INGEST_RATE_LIMIT_RPM="100"
